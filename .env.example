# Copy this file to ".env" (same folder) and fill in real values for anything you want to
# override. ".env" is gitignored and never committed -- this ".env.example" file IS committed,
# so it's safe to leave placeholder text in it. See application.properties for how each of
# these is read via ${VAR_NAME:default} placeholders.

# --- Database ---
# Only needed if you're not using the docker-compose Postgres (which already matches these).
# DB_URL=jdbc:postgresql://localhost:5432/shopforge
# DB_USER=shopforge
DB_PASSWORD=shopforge

# --- JWT signing key ---
# Only needed for a real/shared/deployed environment -- local dev already has a safe generated
# default baked into application.properties.
# JWT_SECRET=generate-your-own-with:-openssl-rand-base64-32

# --- Real email sending (optional) ---
# Leave all of this commented out to use Mailhog (see docker-compose.yml) instead -- Mailhog
# needs no credentials at all. Only fill these in if you want to send through a real Gmail
# account, e.g. to test what an actual received email looks like.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-address@gmail.com
# SMTP_PASSWORD=your-16-character-gmail-app-password
# SMTP_AUTH=true
# SMTP_STARTTLS=true

# --- Razorpay payment gateway (optional) ---
# Leave all of this commented out to disable online payments -- Cash on Delivery works with
# none of it configured. Get free TEST MODE keys at https://dashboard.razorpay.com (Settings >
# API Keys, with "Test Mode" toggled on) to try the Razorpay checkout flow without moving real
# money. RAZORPAY_WEBHOOK_SECRET is a value you choose yourself when adding a webhook endpoint
# in the Razorpay dashboard (Settings > Webhooks), not something from the API Keys page.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your-test-mode-key-secret
# RAZORPAY_WEBHOOK_SECRET=your-chosen-webhook-secret
